#!/bin/sh
set -e

# The control socket group (used by ktbctl from Phase 3 on).
if ! getent group kiss-tnc-bridge >/dev/null; then
    addgroup --system kiss-tnc-bridge
fi

# A first install gets the example config; upgrades keep whatever is there.
if [ ! -f /etc/kiss-tnc-bridge/kiss-tnc-bridge.toml ]; then
    mkdir -p /etc/kiss-tnc-bridge/conf.d
    cp /usr/share/kiss-tnc-bridge/kiss-tnc-bridge.example.toml /etc/kiss-tnc-bridge/kiss-tnc-bridge.toml
fi
